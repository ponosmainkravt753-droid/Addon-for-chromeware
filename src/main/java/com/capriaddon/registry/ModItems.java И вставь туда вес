package com.capriaddon.registry;

import com.capriaddon.CapriAddon;
import net.minecraft.world.item.Item;
import net.neoforged.neoforge.registries.DeferredItem;
import net.neoforged.neoforge.registries.DeferredRegister;

public class ModItems {

    public static final DeferredRegister.Items ITEMS =
            DeferredRegister.createItems("capriaddon");

    public static final DeferredItem<Item> BIO_PROCESSOR =
            ITEMS.register("bio_processor",
                    () -> new Item(new Item.Properties()));

    public static final DeferredItem<Item> CAPRI_CORE =
            ITEMS.register("capri_core",
                    () -> new Item(new Item.Properties()));

    public static final DeferredItem<Item> CAPRI_FLASH_DRIVE =
            ITEMS.register("capri_flash_drive",
                    () -> new Item(new Item.Properties()));

    public static final DeferredItem<Item> CYBERDECK_COMPONENT =
            ITEMS.register("cyberdeck_component",
                    () -> new Item(new Item.Properties()));
}
